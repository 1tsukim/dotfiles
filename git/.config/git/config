# [user] は config.local に分離（git 管理外、default = 個人 noreply）。詳細は config.local.example 参照。
# 業務ディレクトリ（~/project/, ~/work/, ~/workspace/, ~/Documents/）配下では config.work に切り替え。
# 1tsukim 配下のリポでは config.1tsukim に切り替え。
[include]
	path = ~/.config/git/config.local
[color]
	diff = auto
[ghq]
	root = ~/ghq
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = default

# 業務ディレクトリでは user.email を社用に切り替え
[includeIf "gitdir:~/project/"]
	path = ~/.config/git/config.work
[includeIf "gitdir:~/work/"]
	path = ~/.config/git/config.work
[includeIf "gitdir:~/workspace/"]
	path = ~/.config/git/config.work
[includeIf "gitdir:~/Documents/"]
	path = ~/.config/git/config.work

# ~/ghq/github.com/1tsukim/ 配下では user.email を 1tsukim 用 noreply に切り替え
[includeIf "gitdir:~/ghq/github.com/1tsukim/"]
	path = ~/.config/git/config.1tsukim
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
